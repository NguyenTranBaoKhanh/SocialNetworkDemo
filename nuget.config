<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Chỉ dùng nuget.org cho dự án này (clear = bỏ qua mọi nguồn global của máy,
    tránh private feed cần credential làm hỏng restore). Ai clone repo về cũng build được.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
