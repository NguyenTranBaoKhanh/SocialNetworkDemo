@page "/u/{Username}"
@attribute [Authorize]
@inject UserApi UserApi
@inject PostApi PostApi
@inject MediaApi Media
@inject ChatApi Chat
@inject ClientSettings Settings
@inject NavigationManager Nav

<PageTitle>@(_profile?.DisplayName ?? Username)</PageTitle>

<div class="narrow">
@if (_notFound)
{
    <div class="alert alert-warning">Không tìm thấy user.</div>
}
else if (_profile is null)
{
    <p>Đang tải...</p>
}
else
{
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(_profile.AvatarUrl))
            {
                <img src="@Settings.MediaUrl(_profile.AvatarUrl)" class="rounded-circle" alt="avatar"
                     style="width:80px;height:80px;object-fit:cover" />
            }
            else
            {
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white"
                     style="width:80px;height:80px;font-size:2rem;font-weight:700">
                    @_profile.DisplayName.Substring(0, 1).ToUpper()
                </div>
            }

            <div class="flex-grow-1">
                <h1 class="h4 mb-0">@_profile.DisplayName</h1>
                <div class="text-muted">@("@")@_profile.Username</div>
                <div class="mt-2 d-flex gap-3 small">
                    <span><strong>@_profile.PostCount</strong> bài</span>
                    <span><strong>@_profile.FollowerCount</strong> follower</span>
                    <span><strong>@_profile.FollowingCount</strong> following</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_profile.Bio))
                {
                    <p class="mt-2 mb-0" style="white-space: pre-wrap">@_profile.Bio</p>
                }
            </div>

            <div class="d-flex flex-column gap-2">
                @if (_profile.IsMe)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showEdit = true">Chỉnh sửa hồ sơ</button>
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        @(_uploadingAvatar ? "Đang tải..." : "Đổi avatar")
                        <InputFile OnChange="OnAvatarSelectedAsync" accept="image/*" hidden />
                    </label>
                }
                else
                {
                    @if (_profile.IsFollowedByMe)
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="UnfollowAsync">Đang follow</button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="FollowAsync">Follow</button>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="MessageAsync">Nhắn tin</button>
                }
            </div>
        </div>
    </div>

    <h2 class="h5 mb-3">Bài viết</h2>

    @if (_posts.Count == 0)
    {
        <p class="text-muted">Chưa có bài nào.</p>
    }
    else
    {
        @foreach (var post in _posts)
        {
            <PostCard @key="post.Id" Post="post" />
        }

        @if (_nextCursor is not null)
        {
            <button class="btn btn-outline-primary w-100" @onclick="LoadMoreAsync">Tải thêm</button>
        }
    }
}

</div>

@if (_showEdit && _profile is not null)
{
    <EditProfileDialog DisplayName="@_profile.DisplayName" Bio="@_profile.Bio"
                       OnClose="() => _showEdit = false" OnSaved="OnProfileSaved" />
}

@code {
    [Parameter] public string Username { get; set; } = "";

    private UserProfileView? _profile;
    private readonly List<PostResponse> _posts = new();
    private string? _nextCursor;
    private bool _notFound;
    private bool _uploadingAvatar;
    private bool _showEdit;
    private string _loadedFor = "";

    // Nạp lại khi điều hướng sang username khác (component được tái sử dụng).
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Username) return;
        _loadedFor = Username;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _profile = null;
        _notFound = false;
        _posts.Clear();
        _nextCursor = null;
        try
        {
            _profile = await UserApi.GetProfileAsync(Username);
            var page = await PostApi.GetUserPostsAsync(Username);
            if (page is not null) { _posts.AddRange(page.Items); _nextCursor = page.NextCursor; }
        }
        catch
        {
            _notFound = true;
        }
    }

    private async Task LoadMoreAsync()
    {
        var page = await PostApi.GetUserPostsAsync(Username, _nextCursor);
        if (page is not null) { _posts.AddRange(page.Items); _nextCursor = page.NextCursor; }
    }

    private async Task FollowAsync()
    {
        await UserApi.FollowAsync(Username);
        if (_profile is not null)
            _profile = _profile with { IsFollowedByMe = true, FollowerCount = _profile.FollowerCount + 1 };
    }

    private async Task UnfollowAsync()
    {
        await UserApi.UnfollowAsync(Username);
        if (_profile is not null)
            _profile = _profile with { IsFollowedByMe = false, FollowerCount = Math.Max(0, _profile.FollowerCount - 1) };
    }

    private async Task MessageAsync()
    {
        var conv = await Chat.StartDirectAsync(Username);
        if (conv is not null) Nav.NavigateTo($"messages?c={conv.Id}");
    }

    private void OnProfileSaved(UpdateProfileRequest req)
    {
        if (_profile is not null)
            _profile = _profile with { DisplayName = req.DisplayName, Bio = req.Bio };
        _showEdit = false;
    }

    private async Task OnAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        _uploadingAvatar = true;
        try
        {
            var media = await Media.UploadAsync(e.File);
            if (media is not null)
            {
                await UserApi.UpdateAvatarAsync(media.Url);
                if (_profile is not null) _profile = _profile with { AvatarUrl = media.Url };
            }
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }
}
