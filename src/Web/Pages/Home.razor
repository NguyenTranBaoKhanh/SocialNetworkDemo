@page "/"
@attribute [Authorize]
@inject PostApi Api

<PageTitle>Feed</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Feed</h1>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ Tạo bài</button>
</div>

@if (_loading && _posts.Count == 0)
{
    <p>Đang tải...</p>
}
else if (_posts.Count == 0)
{
    <div class="alert alert-info">
        Chưa có bài nào. Hãy
        <a href="#" @onclick:preventDefault @onclick="OpenCreate">tạo bài đầu tiên</a>,
        hoặc follow người khác để thấy bài của họ.
    </div>
}
else
{
    @foreach (var post in _posts)
    {
        <PostCard @key="post.Id" Post="post" />
    }

    @if (_nextCursor is not null)
    {
        <button class="btn btn-outline-primary w-100" @onclick="LoadMoreAsync" disabled="@_loading">
            @(_loading ? "Đang tải..." : "Tải thêm")
        </button>
    }
}

@* Popup tạo bài mới. *@
@if (_showCreate)
{
    <CreatePostDialog OnClose="CloseCreate" OnCreated="OnPostCreated" />
}

@code {
    private readonly List<PostResponse> _posts = new();
    private string? _nextCursor;
    private bool _loading;
    private bool _showCreate;

    protected override Task OnInitializedAsync() => LoadAsync(reset: true);

    private async Task LoadMoreAsync() => await LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        _loading = true;
        var page = await Api.GetFeedAsync(reset ? null : _nextCursor);
        if (page is not null)
        {
            if (reset) _posts.Clear();
            _posts.AddRange(page.Items);
            _nextCursor = page.NextCursor;
        }
        _loading = false;
    }

    private void OpenCreate() => _showCreate = true;
    private void CloseCreate() => _showCreate = false;

    // Đăng bài xong -> thêm lên đầu feed (feed mới-nhất-trước) và đóng popup.
    private void OnPostCreated(PostResponse post)
    {
        _posts.Insert(0, post);
        _showCreate = false;
    }
}
