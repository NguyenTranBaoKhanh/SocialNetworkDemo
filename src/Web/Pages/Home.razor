@page "/"
@attribute [Authorize]
@inject PostApi Api
@inject ClientSettings Settings
@inject NavigationManager Nav

<PageTitle>Feed</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Feed</h1>
    <a class="btn btn-primary btn-sm" href="create">+ Tạo bài</a>
</div>

@if (_loading && _posts.Count == 0)
{
    <p>Đang tải...</p>
}
else if (_posts.Count == 0)
{
    <div class="alert alert-info">
        Chưa có bài nào. Hãy <a href="create">tạo bài đầu tiên</a>, hoặc follow người khác để thấy bài của họ.
    </div>
}
else
{
    @foreach (var post in _posts)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <strong>@post.Author.DisplayName <span class="text-muted fw-normal">@("@")@post.Author.Username</span></strong>
                    <small class="text-muted">@post.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <p class="my-2" style="white-space: pre-wrap">@post.Content</p>
                @if (post.Media.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var m in post.Media)
                        {
                            @if (m.MediaType == "video")
                            {
                                <video src="@Settings.MediaUrl(m.Url)" controls
                                       class="rounded border" style="max-width:100%;max-height:400px"></video>
                            }
                            else
                            {
                                <img src="@Settings.MediaUrl(m.Url)" class="rounded border"
                                     style="max-width:100%;max-height:400px;object-fit:cover" />
                            }
                        }
                    </div>
                }
                <div class="d-flex gap-3 align-items-center">
                    <button class="btn btn-sm @(post.LikedByMe ? "btn-danger" : "btn-outline-danger")"
                            @onclick="() => ToggleLikeAsync(post)">
                        ♥ @post.LikeCount
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" href="@($"post/{post.Id}")">
                        💬 @post.CommentCount
                    </a>
                </div>
            </div>
        </div>
    }

    @if (_nextCursor is not null)
    {
        <button class="btn btn-outline-primary w-100" @onclick="LoadMoreAsync" disabled="@_loading">
            @(_loading ? "Đang tải..." : "Tải thêm")
        </button>
    }
}

@code {
    private readonly List<PostResponse> _posts = new();
    private string? _nextCursor;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync(reset: true);

    private async Task LoadMoreAsync() => await LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        _loading = true;
        var page = await Api.GetFeedAsync(reset ? null : _nextCursor);
        if (page is not null)
        {
            if (reset) _posts.Clear();
            _posts.AddRange(page.Items);
            _nextCursor = page.NextCursor;
        }
        _loading = false;
    }

    private async Task ToggleLikeAsync(PostResponse post)
    {
        var i = _posts.IndexOf(post);
        var result = post.LikedByMe ? await Api.UnlikeAsync(post.Id) : await Api.LikeAsync(post.Id);
        if (result is not null && i >= 0)
            _posts[i] = post with { LikeCount = result.LikeCount, LikedByMe = result.LikedByMe };
    }
}
