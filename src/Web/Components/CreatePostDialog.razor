@inject PostApi Api
@inject MediaApi Media
@inject ClientSettings Settings

@* Modal tạo bài mới ngay tại feed, không chuyển trang. *@
<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)" @onclick="Close">
    <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo bài mới</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <div class="modal-body">
                <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                    <InputTextArea class="form-control mb-2" rows="4" placeholder="Bạn đang nghĩ gì?"
                                   @bind-Value="_model.Content" />

                    <div class="mb-2">
                        <label class="btn btn-outline-secondary btn-sm mb-0">
                            📷 Thêm ảnh/video
                            <InputFile OnChange="OnFilesSelectedAsync" accept="image/*,video/*" multiple hidden />
                        </label>
                        @if (_uploading)
                        {
                            <span class="ms-2 text-muted small">Đang tải lên...</span>
                        }
                    </div>

                    @if (_media.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var m in _media)
                            {
                                <div class="position-relative">
                                    @if (m.MediaType == "video")
                                    {
                                        <video src="@Settings.MediaUrl(m.Url)" style="width:140px;height:100px;object-fit:cover"
                                               class="rounded border" muted></video>
                                    }
                                    else
                                    {
                                        <img src="@Settings.MediaUrl(m.Url)" style="width:100px;height:100px;object-fit:cover"
                                             class="rounded border" />
                                    }
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 py-0 px-1"
                                            @onclick="() => _media.Remove(m)">×</button>
                                </div>
                            }
                        </div>
                    }

                    @if (_error is not null)
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Close">Hủy</button>
                        <button class="btn btn-primary" type="submit"
                                disabled="@(_busy || _uploading || (string.IsNullOrWhiteSpace(_model.Content) && _media.Count == 0))">
                            @(_busy ? "Đang đăng..." : "Đăng")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PostResponse> OnCreated { get; set; }

    private readonly PostModel _model = new();
    private readonly List<CreateMediaDto> _media = new();
    private string? _error;
    private bool _busy;
    private bool _uploading;

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 4))
            {
                var dto = await Media.UploadAsync(file);
                if (dto is not null) _media.Add(dto);
            }
        }
        catch (Exception ex)
        {
            _error = "Tải lên lỗi: " + ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var post = await Api.CreatePostAsync(_model.Content, _media.Count > 0 ? _media : null);
            if (post is not null) await OnCreated.InvokeAsync(post);   // feed thêm bài lên đầu
        }
        catch (Exception ex)
        {
            _error = "Không đăng được bài. " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    private class PostModel
    {
        public string Content { get; set; } = "";
    }
}
