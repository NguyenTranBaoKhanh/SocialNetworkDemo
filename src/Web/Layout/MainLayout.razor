@inherits LayoutComponentBase
@implements IDisposable
@inject AuthApi Auth
@inject UserApi UserApi
@inject ClientSettings Settings
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="app">
    <aside class="sidebar">
        <div class="brand">SocialDemo</div>

        <AuthorizeView>
            <Authorized>
                @{ var name = _me?.DisplayName ?? context.User.Identity?.Name ?? "?"; }
                <a class="user-box text-decoration-none text-reset" href="@($"u/{_me?.Username ?? context.User.Identity?.Name}")">
                    @if (!string.IsNullOrEmpty(_me?.AvatarUrl))
                    {
                        <img class="avatar" src="@Settings.MediaUrl(_me!.AvatarUrl!)" alt="avatar" />
                    }
                    else
                    {
                        <div class="avatar avatar-initial">@name.Substring(0, 1).ToUpper()</div>
                    }
                    <div class="user-meta">
                        <div class="user-name">@name</div>
                        <div class="user-handle">@("@")@(_me?.Username ?? context.User.Identity?.Name)</div>
                    </div>
                </a>

                <nav class="nav-links">
                    <a href="">🏠 Feed</a>
                </nav>

                @if (_suggestions.Count > 0)
                {
                    <div class="suggestions">
                        <div class="suggestions-title">Gợi ý theo dõi</div>
                        @foreach (var s in _suggestions)
                        {
                            <div class="suggestion-item">
                                <a href="@($"u/{s.Username}")" class="suggestion-name text-decoration-none text-reset">
                                    @s.DisplayName <span class="text-muted">@("@")@s.Username</span>
                                </a>
                                <button class="btn btn-primary btn-sm py-0" @onclick="() => FollowAsync(s)">Follow</button>
                            </div>
                        }
                    </div>
                }

                <button class="btn btn-outline-secondary btn-sm logout" @onclick="LogoutAsync">Đăng xuất</button>
            </Authorized>
            <NotAuthorized>
                <nav class="nav-links">
                    <a href="login">Đăng nhập</a>
                    <a href="register">Đăng ký</a>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
    </aside>

    <main class="content">
        <div class="content-inner">
            @Body
        </div>
    </main>
</div>

@code {
    private UserProfile? _me;
    private List<UserSummary> _suggestions = new();

    protected override void OnInitialized()
        => AuthState.AuthenticationStateChanged += OnAuthChanged;

    protected override async Task OnInitializedAsync() => await LoadMeAsync();

    private async void OnAuthChanged(Task<AuthenticationState> _)
    {
        await LoadMeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMeAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _me = await UserApi.GetMeAsync();
            _suggestions = await UserApi.GetSuggestionsAsync();
        }
        else
        {
            _me = null;
            _suggestions = new();
        }
    }

    private async Task FollowAsync(UserSummary s)
    {
        await UserApi.FollowAsync(s.Username);
        _suggestions.Remove(s);   // ẩn khỏi gợi ý sau khi follow
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        _me = null;
        Nav.NavigateTo("login");
    }

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthChanged;
}
