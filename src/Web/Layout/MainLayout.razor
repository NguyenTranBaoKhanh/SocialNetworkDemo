@inherits LayoutComponentBase
@inject AuthApi Auth
@inject NavigationManager Nav

<div class="page">
    <nav class="navbar navbar-expand navbar-dark bg-primary px-3">
        <a class="navbar-brand" href="">SocialDemo</a>
        <div class="navbar-nav flex-row gap-3 ms-auto align-items-center">
            <AuthorizeView>
                <Authorized>
                    <a class="nav-link text-white" href="">Feed</a>
                    <a class="nav-link text-white" href="create">Tạo bài</a>
                    <span class="text-white-50 small">@context.User.Identity?.Name</span>
                    <button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Đăng xuất</button>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link text-white" href="login">Đăng nhập</a>
                    <a class="nav-link text-white" href="register">Đăng ký</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>

    <main class="container py-4">
        @Body
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
